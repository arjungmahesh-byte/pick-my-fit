rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      // Replace with the email you use to sign in to the app as its owner.
      return request.auth != null && request.auth.token.email == "OWNER_EMAIL_HERE";
    }
    match /users/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname','email','joined','lastSeen','opens','platform','count_item_added','count_outfit_saved','count_ai_asked']);
      allow delete: if isOwner() || (request.auth != null && request.auth.uid == uid);
    }
  }
}
